<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbarBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/toolbar_padding_h"
        android:paddingEnd="@dimen/toolbar_padding_h">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/toolbar_button_width"
            android:layout_height="@dimen/toolbar_height"
            android:background="@drawable/button_focusable_bg"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scaleType="center"
            android:src="@drawable/ic_back"
            app:tint="@color/toolbar_icon_tint" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:paddingStart="@dimen/padding_small"
            android:text="@string/conversation_details"
            android:textColor="@color/toolbarText"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Details content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/padding_medium">

            <!-- Contact identity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/padding_medium"
                android:background="@color/surface_base"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/padding_medium">

                <TextView
                    android:id="@+id/tv_identity_avatar"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/avatar_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="@dimen/avatar_text_size"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_medium"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_contact_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/conversationTitle"
                        android:textSize="@dimen/text_size_body_emphasis"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_identity_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/padding_tiny"
                        android:includeFontPadding="false"
                        android:textColor="@color/conversationSnippet"
                        android:textSize="@dimen/text_size_meta" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_tiny"
                android:layout_marginBottom="@dimen/padding_small"
                android:includeFontPadding="false"
                android:text="@string/participants"
                android:textColor="@color/conversationDate"
                android:textSize="@dimen/text_size_small"
                android:textStyle="bold" />

            <!-- Participants list (populated dynamically) -->
            <LinearLayout
                android:id="@+id/participant_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/padding_medium" />

            <!-- Action: Set contact color -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/padding_small"
                android:paddingTop="@dimen/padding_small"
                android:paddingBottom="@dimen/padding_small"
                android:text="@string/appearance"
                android:textColor="@color/colorSecondary"
                android:textSize="@dimen/text_size_meta"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/row_color"
                android:layout_width="match_parent"
                android:layout_height="@dimen/conversation_item_height"
                android:background="@drawable/details_row_bg"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium">

                <View
                    android:id="@+id/color_swatch"
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/avatar_bg"
                    android:contentDescription="@null"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/btn_color"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_medium"
                    android:focusable="false"
                    android:text="@string/contact_color"
                    android:textColor="@color/conversationSnippet"
                    android:textSize="@dimen/text_size_normal" />

                <TextView
                    android:id="@+id/tv_color_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/padding_small"
                    android:includeFontPadding="false"
                    android:textColor="@color/conversationDate"
                    android:textSize="@dimen/text_size_meta" />

            </LinearLayout>

            <!-- Action: Rename conversation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/padding_small"
                android:paddingTop="@dimen/padding_large"
                android:paddingBottom="@dimen/padding_small"
                android:text="@string/conversation_actions"
                android:textColor="@color/colorSecondary"
                android:textSize="@dimen/text_size_meta"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_rename"
                android:layout_width="match_parent"
                android:layout_height="@dimen/conversation_item_height"
                android:background="@drawable/details_row_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:text="@string/rename_conversation"
                android:textColor="@color/colorOnBackground"
                android:includeFontPadding="false"
                android:textSize="@dimen/text_size_body" />

            <!-- Action: Block -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/padding_small"
                android:paddingTop="@dimen/padding_large"
                android:paddingBottom="@dimen/padding_small"
                android:text="@string/danger_zone"
                android:textColor="@color/statusFailed"
                android:textSize="@dimen/text_size_meta"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_block"
                android:layout_width="match_parent"
                android:layout_height="@dimen/conversation_item_height"
                android:layout_marginTop="@dimen/padding_tiny"
                android:background="@drawable/details_row_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/padding_medium"
                android:paddingEnd="@dimen/padding_medium"
                android:text="@string/block"
                android:textColor="@color/statusFailed"
                android:includeFontPadding="false"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
