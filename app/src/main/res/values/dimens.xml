<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ────────────────────────────────────────────────────────────────────────
         Dimensions optimized for ~240×320 and 320×480 dumbphone screens.
         All sizes are deliberately compact — no 48dp touch targets needed
         since the device is fully D-Pad navigated.
         ──────────────────────────────────────────────────────────────────────── -->

    <!-- ─── Toolbar / Action Bar ─── -->
    <dimen name="toolbar_height">34dp</dimen>
    <dimen name="toolbar_button_width">30dp</dimen>
    <dimen name="toolbar_padding_h">4dp</dimen>

    <!-- ─── Conversation List Items ─── -->
    <dimen name="conversation_item_height">50dp</dimen>
    <dimen name="avatar_size">28dp</dimen>
    <dimen name="avatar_text_size">12sp</dimen>
    <dimen name="conversation_padding_h">6dp</dimen>
    <dimen name="conversation_padding_v">4dp</dimen>
    <dimen name="unread_badge_size">18dp</dimen>
    <dimen name="unread_badge_text_size">10sp</dimen>

    <!-- ─── Message Bubbles ─── -->
    <!-- Padding in sp units to scale with font size, preventing clipping in large/extra large modes -->
    <dimen name="bubble_padding_h">10sp</dimen>
    <dimen name="bubble_padding_v">6sp</dimen>
    <dimen name="bubble_corner_radius">2dp</dimen>
    <dimen name="bubble_margin_h">2dp</dimen>
    <dimen name="bubble_margin_v">2dp</dimen>
    <dimen name="bubble_sender_margin_top">2dp</dimen>
    <dimen name="attachment_preview_width">60dp</dimen>
    <dimen name="attachment_preview_height">45dp</dimen>

    <!-- ─── Compose Bar ─── -->
    <dimen name="compose_bar_height">36dp</dimen>
    <dimen name="compose_button_size">30dp</dimen>
    <dimen name="compose_input_padding_h">6dp</dimen>
    <dimen name="compose_input_padding_v">4dp</dimen>
    <dimen name="compose_padding">4dp</dimen>
    <dimen name="compose_input_corner_radius">2dp</dimen>

    <!-- ─── Date Headers ─── -->
    <dimen name="date_header_height">24dp</dimen>
    <dimen name="date_header_text_size">10sp</dimen>

    <!-- ─── Typography ─── -->
    <!-- Named roles keep compact layouts readable without relying on size alone. -->
    <dimen name="text_size_meta">11sp</dimen>
    <dimen name="text_size_body">13sp</dimen>
    <dimen name="text_size_body_emphasis">14sp</dimen>
    <dimen name="text_size_action">15sp</dimen>
    <dimen name="text_size_screen_title">16sp</dimen>
    <!-- Legacy aliases for layouts not yet migrated to semantic roles. -->
    <dimen name="text_size_small">@dimen/text_size_meta</dimen>
    <dimen name="text_size_normal">@dimen/text_size_body</dimen>
    <dimen name="text_size_medium">@dimen/text_size_body_emphasis</dimen>
    <dimen name="text_size_large">@dimen/text_size_action</dimen>
    <dimen name="text_size_title">@dimen/text_size_screen_title</dimen>

    <!-- ─── Focus Ring (D-Pad visual feedback) ─── -->
    <dimen name="focus_border_width">1dp</dimen>
    <dimen name="focus_corner_radius">2dp</dimen>

    <!-- ─── Spacing ─── -->
    <dimen name="padding_tiny">2dp</dimen>
    <dimen name="padding_small">4dp</dimen>
    <dimen name="padding_medium">8dp</dimen>
    <dimen name="padding_large">12dp</dimen>

    <!-- ─── Divider ─── -->
    <dimen name="divider_height">0.5dp</dimen>

    <!-- ─── Recipient chips (New conversation) ─── -->
    <dimen name="recipient_chip_min_height">24dp</dimen>
    <dimen name="recipient_chip_padding_h">10dp</dimen>
    <dimen name="recipient_chip_padding_v">3dp</dimen>
    <dimen name="recipient_chip_margin_end">6dp</dimen>
    <dimen name="recipient_chip_corner_radius">10dp</dimen>
    <dimen name="recipient_chip_text_size">12sp</dimen>

    <!-- ─── Image viewer overlay ─── -->
    <dimen name="image_viewer_overlay_margin">12dp</dimen>
    <dimen name="image_viewer_overlay_padding_h">8dp</dimen>
    <dimen name="image_viewer_overlay_padding_v">4dp</dimen>

    <!-- ─── Schedule picker ─── -->
    <dimen name="schedule_picker_padding">12dp</dimen>
    <dimen name="schedule_picker_label_width">72dp</dimen>
    <dimen name="schedule_picker_stepper_size">40dp</dimen>

    <!-- ─── Conversation row indicators ─── -->
    <dimen name="conversation_indicator_size">12dp</dimen>
    <dimen name="conversation_indicator_margin_start">2dp</dimen>
    <dimen name="conversation_menu_button_size">28dp</dimen>
</resources>
