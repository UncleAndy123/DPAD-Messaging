<?xml version="1.0" encoding="utf-8"?>
<!--
    Main conversation list screen.

    Focus zones (D-Pad traversal order, top → bottom):
      1. Toolbar buttons (btn_new, btn_search, btn_overflow)
      2. DpadRecyclerView (conversation items)

    Focus enters the list via D-Pad DOWN from the toolbar.
    D-Pad UP from the first conversation item returns to the toolbar.
    Search overlay slides in over the list when activated.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- ─── Toolbar ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbarBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/toolbar_padding_h"
        android:paddingEnd="@dimen/toolbar_padding_h">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:paddingStart="@dimen/padding_small"
            android:text="@string/app_name"
            android:textColor="@color/toolbarText"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- New Conversation -->
        <ImageButton
            android:id="@+id/btn_new_conversation"
            style="@style/ToolbarButton"
            android:contentDescription="@string/new_conversation"
            android:src="@drawable/ic_new_message"
            android:nextFocusLeft="@id/btn_overflow"
            android:nextFocusRight="@id/btn_search"
            android:nextFocusDown="@id/rv_conversations" />

        <!-- Search -->
        <ImageButton
            android:id="@+id/btn_search"
            style="@style/ToolbarButton"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search"
            android:nextFocusLeft="@id/btn_new_conversation"
            android:nextFocusRight="@id/btn_overflow"
            android:nextFocusDown="@id/rv_conversations" />

        <!-- Overflow / More -->
        <ImageButton
            android:id="@+id/btn_overflow"
            style="@style/ToolbarButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more_vert"
            android:nextFocusLeft="@id/btn_search"
            android:nextFocusRight="@id/btn_new_conversation"
            android:nextFocusDown="@id/rv_conversations" />

    </LinearLayout>

    <!-- Explicit selection mode for keypad/D-pad users; no swipe or long-press required. -->
    <LinearLayout
        android:id="@+id/selection_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbarBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/toolbar_padding_h"
        android:paddingEnd="@dimen/toolbar_padding_h"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/toolbarText"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_selection_archive"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/compose_button_size"
            android:background="@drawable/button_focusable_bg"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:text="@string/archive" />

        <Button
            android:id="@+id/btn_selection_read"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/compose_button_size"
            android:background="@drawable/button_focusable_bg"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:text="@string/mark_as_read" />

        <Button
            android:id="@+id/btn_selection_clear"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/compose_button_size"
            android:background="@drawable/button_focusable_bg"
            android:contentDescription="@string/cancel"
            android:text="@string/cancel" />
    </LinearLayout>

    <!-- ─── Search Overlay (GONE by default) ───────────────────────────── -->
    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:background="@color/toolbarBg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/toolbar_padding_h"
        android:paddingEnd="@dimen/toolbar_padding_h"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btn_search_close"
            style="@style/ToolbarButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back"
            android:nextFocusRight="@id/et_search" />

        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            android:singleLine="true"
            android:textColor="@color/colorOnBackground"
            android:textColorHint="@color/composeHint"
            android:textSize="@dimen/text_size_normal"
            android:nextFocusLeft="@id/btn_search_close"
            android:nextFocusDown="@id/rv_conversations" />

    </LinearLayout>

    <!-- ─── Conversation List ────────────────────────────────────────────── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.dpad.messaging.views.DpadRecyclerView
            android:id="@+id/rv_conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:scrollbars="vertical" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/tv_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:gravity="center"
            android:padding="@dimen/padding_large"
            android:text="@string/no_conversations"
            android:textColor="@color/emptyText"
            android:textSize="@dimen/text_size_normal"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/loading_conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_large"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:text="@string/loading_conversations"
                android:textColor="@color/emptyText"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

        <!-- Actionable load failure state. Kept separate from the empty state so
             an unavailable provider is not presented as an empty inbox. -->
        <LinearLayout
            android:id="@+id/conversation_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/padding_large"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/conversations_load_failed"
                android:textColor="@color/emptyText"
                android:textSize="@dimen/text_size_normal" />

            <Button
                android:id="@+id/btn_retry_conversations"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/compose_button_size"
                android:layout_marginTop="@dimen/padding_small"
                android:background="@drawable/button_focusable_bg"
                android:focusable="true"
                android:text="@string/retry"
                android:textSize="@dimen/text_size_small" />
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
