<?xml version="1.0" encoding="utf-8"?>
<!-- Sent message bubble: rounded on all corners except bottom-right -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/sentMessageBubbleFocusedColor"/>
            <stroke android:width="@dimen/focus_border_width" android:color="?attr/colorControlActivated"/>
            <corners android:radius="@dimen/bubble_corner_radius"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/sentMessageBubbleColor"/>
            <corners android:radius="@dimen/bubble_corner_radius"/>
        </shape>
    </item>
</selector>
